---
import { ui, href } from '../lib/i18n.js';

const { lang } = Astro.props;
const t = ui[lang];
const built = new Intl.DateTimeFormat(t.locale, {
  dateStyle: 'medium',
  timeStyle: 'short',
  timeZone: 'Europe/Zurich',
}).format(new Date());
---

<footer class="site-footer">
  <span><span class="led" aria-hidden="true"></span>smog.sh · {t.built}: {built}</span>
  <nav class="footer-links" aria-label="Carlos Ha · Zürich">
    <a href={href(lang, '/speaking/')}>{t.footerSpeaking}</a>
    <a href={href(lang, '/colophon/')}>{t.footerColophon}</a>
    <a href={href(lang, '/rss.xml')}>{t.feed}</a>
  </nav>
</footer>
