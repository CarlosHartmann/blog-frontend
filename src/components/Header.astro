---
import Nav from './Nav.astro';
import { href } from '../lib/i18n.js';

const { lang, path, current } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href={href(lang, '/')}>smog.sh<span class="cursor" aria-hidden="true"></span></a>
  <Nav lang={lang} path={path} current={current} />
</header>
