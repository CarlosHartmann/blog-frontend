---
import Base from '../layouts/Base.astro';
import { ui, href, formatDate } from '../lib/i18n.js';
import { getPosts } from '../lib/wp.js';

const { lang, post } = Astro.props;
const t = ui[lang];
const posts = await getPosts();
const index = posts.findIndex((p) => p.slug === post.slug);
const newer = posts[index - 1];
const older = posts[index + 1];

// On the English pages a post shows its English version if it has one,
// otherwise the German text with a note.
const inEnglish = (p) => (lang === 'en' && p.en ? p.en : p);
const body = inEnglish(post);
const bodyLang = body === post ? 'de' : 'en';
---

<Base
  lang={lang}
  path={`/${post.slug}/`}
  title={body.titleText}
  description={body.excerpt}
  image={post.image}
  published={`${post.dateGmt}Z`}
  article
  canonicalLang={bodyLang}
  current="blog"
>
  <main id="inhalt" class="page">
    <div class="leaf-grid">
      <aside class="side" aria-label={t.postMeta}>
        <a class="back" href={href(lang, '/posts/')}>← {t.back}</a>
        <dl>
          <div>
            <dt>{t.shelfmark}</dt>
            <dd>MS smog.sh · Nr. {post.nr}</dd>
          </div>
          <div>
            <dt>{t.date}</dt>
            <dd><time datetime={post.date}>{formatDate(post.date, lang)}</time></dd>
          </div>
          <div>
            <dt>{t.length}</dt>
            <dd>{t.readingTime(body.minutes)}</dd>
          </div>
        </dl>
        {bodyLang !== lang && <p class="note" style="margin: 0">{t.germanOnly}</p>}
      </aside>

      <article class="paper" lang={bodyLang}>
        <h1 class="title" set:html={body.title} />
        <div class="rule" aria-hidden="true"></div>
        <div class="prose">
          {
            (body.toc.length > 0 || body.lead) && (
              <div class="gloss lead">
                {body.toc.length > 0 && (
                  <nav class="gloss toc" aria-label={t.contents}>
                    <span class="label" lang={lang}>{t.contents}</span>
                    <ol>
                      {body.toc.map((entry) => (
                        <li>
                          <a href={`#${entry.id}`}>
                            <span class="num">{entry.num}</span>
                            <span>{entry.text}</span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </nav>
                )}
                <Fragment set:html={body.lead} />
              </div>
            )
          }
          <Fragment set:html={body.html} />
        </div>
        <nav class="post-nav" aria-label={t.blogTitle}>
          {
            older ? (
              <a href={href(lang, `/${older.slug}/`)} rel="prev">
                <span class="mono" lang={lang}>← {t.older}</span>
                <span set:html={inEnglish(older).title} />
              </a>
            ) : (
              <span />
            )
          }
          {
            newer && (
              <a href={href(lang, `/${newer.slug}/`)} rel="next">
                <span class="mono" lang={lang}>{t.newer} →</span>
                <span set:html={inEnglish(newer).title} />
              </a>
            )
          }
        </nav>
      </article>
    </div>
  </main>
</Base>
