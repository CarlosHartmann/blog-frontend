---
import Base from '../layouts/Base.astro';
import { ui, href } from '../lib/i18n.js';
import { profile, links, sections, pick } from '../data/cv.js';

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} path="/cv/" title={t.cvTitle} description={profile[lang].replace(/<[^>]+>/g, '')} current="cv">
  <main id="inhalt" class="page">
    <div class="leaf-grid">
      <aside class="side">
        <nav aria-label={t.pubsSections}>
          {sections.map((section) => <a href={`#${section.id}`}>{pick(section.title, lang)}</a>)}
        </nav>
      </aside>

      <section class="paper">
        <p class="kicker mono">{t.cvKicker}</p>
        <h1 class="title">Carlos Hartmann</h1>
        <p class="lede" set:html={profile[lang]} />
        <p class="print-only">www.smog.sh{href(lang, '/cv/')} · {new Intl.DateTimeFormat(t.locale, { month: 'long', year: 'numeric' }).format(new Date())}</p>
        <p class="cv-links mono">
          {links.map((link) => <a href={link.url}>{link.label}</a>)}
          <a href={href(lang, '/publications/')}>{t.nav.publications}</a>
          <a href={href(lang, '/contact/')}>{t.nav.contact}</a>
          <a href={`/cv/carlos-hartmann-cv-${lang}.pdf`}>{t.cvPdf}</a>
        </p>
        <div class="rule" aria-hidden="true" style="margin-bottom: 0"></div>
        <div class="entries">
          {
            sections.map((section) => {
              const title = pick(section.title, lang);
              return (
                <>
                  <h2 id={section.id}><span class="hash" aria-hidden="true">#</span>{title}</h2>
                  {section.note && <p class="cv-note" set:html={pick(section.note, lang)} />}
                  <ul>
                    {section.items.map((item) => {
                      const link = item.post ? href(lang, `/${item.post}/`) : item.url;
                      return (
                        <li>
                          <span class="year">{pick(item.when, lang)}</span>
                          <span class="what">{link ? <a href={link} set:html={pick(item.what, lang)} /> : <Fragment set:html={pick(item.what, lang)} />}</span>
                          {item.detail && <span class="detail" set:html={pick(item.detail, lang)} />}
                        </li>
                      );
                    })}
                  </ul>
                </>
              );
            })
          }
        </div>
      </section>
    </div>
  </main>
</Base>
