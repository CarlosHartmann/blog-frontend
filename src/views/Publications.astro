---
import Base from '../layouts/Base.astro';
import { ui, href } from '../lib/i18n.js';
import { research, sections, pick } from '../data/publications.js';

const { lang } = Astro.props;
const t = ui[lang];
---

<Base lang={lang} path="/publications/" title={t.pubsTitle} description={t.pubsIntro} current="publications">
  <main id="inhalt" class="page">
    <div class="leaf-grid">
      <aside class="side">
        <nav aria-label={t.pubsSections}>
          {sections.map((section) => <a href={`#${section.id}`}>{pick(section.title, lang)}</a>)}
        </nav>
      </aside>

      <section class="paper">
        <p class="kicker mono">{t.pubsKicker}</p>
        <h1 class="title">{t.pubsTitle}</h1>
        <p class="lede">{t.pubsIntro}</p>
        <div class="rule" aria-hidden="true"></div>
        <div class="prose">
          <p class="initiale" set:html={research[lang]} />
        </div>
        <p class="sheet-cta">
          <a class="button" href={href(lang, '/they/')}>{t.tryIt}</a>
        </p>
        <div class="entries">
          {
            sections.map((section) => {
              const title = pick(section.title, lang);
              return (
                <>
                  <h2 id={section.id}><span class="hash" aria-hidden="true">#</span>{title}</h2>
                  <ul>
                    {section.items.map((item) => {
                      const link = item.post ? href(lang, `/${item.post}/`) : item.url;
                      return (
                        <li>
                          <span class="year">{pick(item.year, lang)}</span>
                          <span class="what">{link ? <a href={link} set:html={pick(item.title, lang)} /> : <Fragment set:html={pick(item.title, lang)} />}</span>
                          <span class="detail" set:html={pick(item.detail, lang)} />
                        </li>
                      );
                    })}
                  </ul>
                </>
              );
            })
          }
        </div>
      </section>
    </div>
  </main>
</Base>
