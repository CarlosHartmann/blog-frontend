---
// Landing page: one film still, full screen, with the navigation on top.
// Every visit shows a different still (reload, coming back from another page,
// the browser's Back button); the list comes from the banner media folder.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { getBanners } from '../lib/wp.js';

const { lang } = Astro.props;

// The stills in the media library are often multi-megabyte PNGs. Re-encode
// them once per build (never upscaling) so the home page stays light.
const MAX_WIDTH = 1920;
const banners = await Promise.all(
  (await getBanners()).map(async (banner) => {
    const width = Math.min(banner.width, MAX_WIDTH);
    const height = Math.round((banner.height * width) / banner.width);
    const image = await getImage({ src: banner.src, width, height, format: 'webp', quality: 72 });
    return { src: image.src, alt: banner.alt };
  }),
);
---

<Base lang={lang} path="/" current="home" bare>
  <main id="inhalt" class="home">
    <img class="banner" id="banner" alt="" fetchpriority="high" />
    <noscript><img class="banner" src={banners[0].src} alt={banners[0].alt} /></noscript>
    <div class="home-box">
      <h1 class="wordmark" style="margin: 0; font-weight: 400">smog.sh</h1>
      <Nav lang={lang} path="/" current="home" />
    </div>
  </main>
  <script is:inline define:vars={{ banners }}>
    // Pick a still at random, never the one shown on the previous visit.
    const show = () => {
      let last = -1;
      try {
        last = Number(sessionStorage.getItem('banner') ?? -1);
      } catch (e) {}
      let next = Math.floor(Math.random() * banners.length);
      if (banners.length > 1 && next === last) next = (next + 1) % banners.length;
      try {
        sessionStorage.setItem('banner', String(next));
      } catch (e) {}
      const img = document.getElementById('banner');
      img.src = banners[next].src;
      img.alt = banners[next].alt;
    };
    show();
    // Pages restored by the Back button are not reloaded, so pick again.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted) show();
    });
  </script>
</Base>
